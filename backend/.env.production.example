# === Production Environment ===
# Copy this to .env and fill in REAL values before deploying

ENVIRONMENT=production

# Supabase PostgreSQL (get from Supabase dashboard → Settings → Database)
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:YOUR_PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres

# Auth0 (get from Auth0 Dashboard → Applications → Your App)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_API_AUDIENCE=https://photo-map-api.example.com

# Azure Blob Storage (get from Azure Portal → Storage Account → Access Keys)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_NAME=media
AZURE_STORAGE_THUMBNAILS_CONTAINER=thumbnails

# CORS — your deployed frontend URL
CORS_ORIGINS=https://your-app.azurestaticapps.net

# MUST be false in production!
DEV_AUTH_BYPASS=false

# Max upload size (MB)
MAX_UPLOAD_SIZE_MB=100
